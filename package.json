{
  "name": "partyroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/make-sounds.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "backend": "convex dev",
    "issues:publish": "node scripts/publish-issues.mjs",
    "predev": "node scripts/make-sounds.mjs"
  },
  "dependencies": {
    "convex": "^1.25.0",
    "mespeak": "^2.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "convex-test": "^0.0.38",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
